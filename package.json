{
  "name": "whatsapp",
  "version": "0.1.0",
  "private": true,
  "description": "Personal WhatsApp Web desktop window with a remembered login, tray, and notifications.",
  "author": "Carlos Wei <carlos.wei.hk@gmail.com>",
  "homepage": "https://github.com/carloscn/whatsapp",
  "desktopName": "whatsapp.desktop",
  "main": "src/main.js",
  "devDependencies": {
    "electron": "^44.9.0",
    "electron-builder": "^26.15.3"
  },
  "scripts": {
    "postinstall": "node node_modules/electron/install.js",
    "start": "scripts/launch.sh",
    "install-launcher": "node scripts/install-launcher.js",
    "dist": "electron-builder --linux AppImage deb",
    "dist:deb": "electron-builder --linux deb --publish never",
    "render-icon": "python3 scripts/render-icon.py"
  },
  "build": {
    "appId": "dev.carloscn.whatsapp",
    "productName": "WhatsApp",
    "asar": true,
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json"
    ],
    "linux": {
      "executableName": "whatsapp",
      "icon": "assets/icon.png",
      "category": "Network",
      "synopsis": "Personal WhatsApp Web desktop",
      "executableArgs": [
        "--ozone-platform=x11",
        "--disable-vulkan"
      ],
      "target": [
        "AppImage",
        "deb"
      ]
    },
    "deb": {
      "artifactName": "whatsapp_${version}_${arch}.${ext}",
      "afterInstall": "build/after-install.tpl",
      "afterRemove": "build/after-remove.tpl",
      "depends": [
        "libgtk-3-0t64 | libgtk-3-0",
        "libnotify4",
        "libnss3",
        "libxss1",
        "libxtst6",
        "xdg-utils",
        "libatspi2.0-0t64 | libatspi2.0-0",
        "libuuid1",
        "libsecret-1-0",
        "libgbm1",
        "libasound2t64 | libasound2"
      ],
      "recommends": [
        "libayatana-appindicator3-1"
      ]
    }
  }
}
